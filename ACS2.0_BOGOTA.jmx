      <hashTree>
        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="AutoGenerate_MAWB" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);

int count1 = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno1=count1%7;
String AWB1=(count1.toString()).concat(modno1.toString());
vars.put(&quot;AWBNO1&quot;,AWB1);

int countF = ThreadLocalRandom.current().nextInt(1001, 2000);
String Flight=countF.toString();
vars.put(&quot;FLIGHT&quot;,Flight);

int count = ThreadLocalRandom.current().nextInt(10, 1000);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;Shipper&quot;,AWB);
</stringProp>
        </BeanShellSampler>
        <hashTree/>

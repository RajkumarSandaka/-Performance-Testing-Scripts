            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">{&quot;BusinessType&quot;:&quot;Agent and Trucker&quot;,&quot;BusinessTypeId&quot;:1264,&quot;OrgProdId&quot;:26007,&quot;OrgId&quot;:84199,&quot;UserId&quot;:15616,&quot;SearchedVal&quot;:&quot;&quot;,&quot;TopRecords&quot;:10,&quot;BasedonPrevious&quot;:&quot;229&quot;,&quot;jointablename&quot;:&quot;Organization as org on C.OrgId=org.OrgId  inner join  Stock_Org_DocumentType s on C.Orgid=s.DestOrgID AND C.RegistrationPaymentStatus = &apos;&apos;PAID&apos;&apos; AND C.RequestStatus = &apos;&apos;Activated&apos;&apos;\n      AND\tC.SubscriptionStatus = &apos;&apos;Active&apos;&apos; AND ISNULL(s.IsDeleted,0) = 0  inner join Organization_Businessline org1 on org1.OrgId = C.OrgId inner join Admin_Company Ac on C.OrgId=Ac.OrgId and Coalesce(AC.IsActive,0)=1 and Coalesce(AC.IsDeleted,0)=0 inner join Admin_UserBranchDetails AB on AB.CompId = Ac.CompId and Coalesce(AB.IsDeleted,0)=0 inner join Admin_UserMaster Au&quot;,&quot;jointablecondition&quot;:&quot;Au.UserId=AB.UserId and Coalesce(AC.IsActive,0)=1  and Coalesce(Au.IsDeleted,0)=0 &quot;,&quot;wherecondition&quot;:&quot;C.IATATwoLetterCode !=&apos;&apos;&apos;&apos; and C.RegistrationPaymentStatus=&apos;&apos;PAID&apos;&apos; and C.RequestStatus=&apos;&apos;Activated&apos;&apos; and C.SubscriptionStatus=&apos;&apos;Active&apos;&apos; and org1.Businessline in (&apos;&apos;Airline&apos;&apos;,&apos;&apos;GSA&apos;&apos;) and C.IATATwoLetterCode is not null  AND s.Prefix = &apos;&apos;229&apos;&apos;&quot;,&quot;description&quot;:&quot;C.IATATwoLetterCode&quot;,&quot;value&quot;:&quot;C.IATATwoLetterCode&quot;,&quot;IsActive&quot;:&quot;1&quot;,&quot;name&quot;:&quot;c.IATATwoLetterCode&quot;}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>

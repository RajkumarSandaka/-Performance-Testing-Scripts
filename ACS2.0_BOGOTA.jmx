          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);

int countA = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modnoA=countA%7;
String AWBA=(countA.toString()).concat(modnoA.toString());
vars.put(&quot;AWBNOA&quot;,AWBA);

int count = ThreadLocalRandom.current().nextInt(10, 1000);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;Shipper&quot;,AWB);</stringProp>

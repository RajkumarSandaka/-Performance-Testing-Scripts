// Get the current thread number (0-based index)
def threadNum = ctx.getThreadNum()

// Assign username to the thread
if (threadNum &lt; usernames.size()) {
    vars.put(&apos;username&apos;, usernames[threadNum])
} else {
    // Handle the case when there are more threads than usernames
    log.warn(&quot;Not enough usernames for all threads. Assigning default username.&quot;)
    vars.put(&apos;username&apos;, &apos;defaultUser&apos;)
}

// Log the assigned username for debugging purposes
log.info(&quot;Thread number: ${threadNum}, Username: ${vars.get(&apos;username&apos;)}&quot;)</stringProp>

        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="AutoGenerate_MAWB">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);

int count1 = ThreadLocalRandom.current().nextInt(2, 1000);
String Flight=count1.toString();
vars.put(&quot;ShipperNo&quot;,Flight);

int count2 = ThreadLocalRandom.current().nextInt(2, 1000);
String Flight1=count2.toString();
vars.put(&quot;ConsigneeNo&quot;,Flight1);
</stringProp>
        </BeanShellSampler>

        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="AutoGenerate_MAWB" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);

int count1 = ThreadLocalRandom.current().nextInt(3, 100);
//var modno=count%7;
String AWB1=count1.toString();
vars.put(&quot;Consigneeno&quot;,AWB1);

int count2 = ThreadLocalRandom.current().nextInt(1001, 2000);
//var modno=count%7;
String AWB2=count2.toString();
vars.put(&quot;ULDNO&quot;,AWB2);


int count3 = ThreadLocalRandom.current().nextInt(1001, 2000);
//var modno=count%7;
String AWB3=count3.toString();
vars.put(&quot;Flightno&quot;,AWB3);

int count4 = ThreadLocalRandom.current().nextInt(1001, 2000);
//var modno=count%7;
String AWB4=count4.toString();
vars.put(&quot;CUSTOMREF&quot;,AWB4);

int count5 = ThreadLocalRandom.current().nextInt(1234567, 7654321);
//var modno=count%7;
String AWB5=count5.toString();
vars.put(&quot;GroupID&quot;,AWB5);</stringProp>

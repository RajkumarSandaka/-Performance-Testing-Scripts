        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="BeanShell Sampler-IMO" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;

long count1 = ThreadLocalRandom.current().nextLong(1000001, 1000500); // 7-digit
String voy1 = Long.toString(count1);
vars.put(&quot;IMONO&quot;, voy1);

long count2 = ThreadLocalRandom.current().nextLong(1001, 1200); // 7-digit
String voy2 = Long.toString(count2);
vars.put(&quot;BAYAN&quot;, voy2);


long count3 = ThreadLocalRandom.current().nextLong(10001, 10200); // 7-digit
String voy3 = Long.toString(count3);
vars.put(&quot;VoyageCode&quot;, voy3);

long count4 = ThreadLocalRandom.current().nextLong(10001, 10200); // 7-digit
String voy4 = Long.toString(count4);
vars.put(&quot;CARCODE&quot;, voy4);

long count5 = ThreadLocalRandom.current().nextLong(10001, 10200); // 7-digit
String voy5 = Long.toString(count5);
vars.put(&quot;Vesselname&quot;, voy5);</stringProp>
        </BeanShellSampler>

        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="AutoGenerate_MAWB" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

/*int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);*/

int count1 = ThreadLocalRandom.current().nextInt(2001, 9000);
String Flight=count1.toString();
vars.put(&quot;VehicleNo&quot;,Flight);

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;BOEACI&quot;,AWB);

int count2 = ThreadLocalRandom.current().nextInt(2001, 9000);
String Drive=count2.toString();
vars.put(&quot;Drivinglicense&quot;,Drive);

int count3 = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno1=count3%7;
String HSN=(count3.toString()).concat(modno1.toString());
vars.put(&quot;HSNCODE&quot;,HSN);


int count4 = ThreadLocalRandom.current().nextInt(10000, 99999);
String Phone=count4.toString();
vars.put(&quot;Phoneno&quot;,Phone);</stringProp>
        </BeanShellSampler>

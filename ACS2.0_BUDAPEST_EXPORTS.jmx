      <hashTree>
        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="AutoGenerate_MAWB" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.concurrent.ThreadLocalRandom;
import java.lang.*;

/*int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);*/

int count1 = ThreadLocalRandom.current().nextInt(901, 1500);
String Flight=count1.toString();
vars.put(&quot;ShiperNo&quot;,Flight);

int count1 = ThreadLocalRandom.current().nextInt(901, 1500);
String Flightcon=count1.toString();
vars.put(&quot;ConsigneeNo&quot;,Flightcon);

int count = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modno=count%7;
String AWB=(count.toString()).concat(modno.toString());
vars.put(&quot;AWBNO&quot;,AWB);

int countgroup = ThreadLocalRandom.current().nextInt(1234567, 7654321);
var modnoo=count%7;
String Group=(countgroup.toString()).concat(modnoo.toString());
vars.put(&quot;AWBNUMBER&quot;,Group);

int countULD = ThreadLocalRandom.current().nextInt(3001, 4000);
String ULD=countULD.toString();
vars.put(&quot;ULDNO&quot;,ULD);</stringProp>
          <stringProp name="BeanShellSampler.filename"></stringProp>
          <stringProp name="BeanShellSampler.parameters"></stringProp>
          <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
        </BeanShellSampler>
